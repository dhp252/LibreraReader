<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dip">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/aiProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dip"
            android:layout_height="20dip"
            android:layout_marginRight="6dip" />

        <TextView
            android:id="@+id/aiStatus"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.75"
            android:padding="4dip"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/aiCopy"
            android:layout_width="36dip"
            android:layout_height="36dip"
            android:background="@drawable/bg_round_press"
            android:contentDescription="@string/copy"
            android:padding="7dip"
            android:src="@drawable/glyphicons_614_copy"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/aiShare"
            android:layout_width="36dip"
            android:layout_height="36dip"
            android:background="@drawable/bg_round_press"
            android:contentDescription="@string/share"
            android:padding="7dip"
            android:src="@drawable/glyphicons_578_share"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/aiText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:padding="4dip"
            android:textIsSelectable="true"
            android:textSize="16sp" />
    </ScrollView>
</LinearLayout>
