<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dip">

        <RadioGroup
            android:id="@+id/aiProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/aiClaude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_provider_claude" />

            <RadioButton
                android:id="@+id/aiOpenAi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_provider_openai" />
        </RadioGroup>

        <EditText
            android:id="@+id/aiUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ai_url"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/aiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ai_key"
            android:inputType="textPassword"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/aiShowKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_show_key" />

        <EditText
            android:id="@+id/aiModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ai_model"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/aiLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ai_language"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/aiMasterPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/ai_master_prompt"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="6"
            android:minLines="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="4dip"
            android:paddingTop="6dip"
            android:text="@string/ai_max_chars"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/aiMaxChars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            android:id="@+id/aiTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dip"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
