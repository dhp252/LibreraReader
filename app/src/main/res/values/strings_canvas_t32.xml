<!-- Strings of "How you read it" (task t32; canvas artboard "How you read the chapter").
     English only, kept out of strings.xml and strings_fork.xml so parallel work does not conflict.
     Every number on the screen is a stored page counter; a section is rated from page times. -->
<resources>
    <string name="canvas_t32_title">How you read it</string>
    <string name="canvas_t32_menu">How you read this chapter</string>
    <string name="canvas_t32_nothing">No page times are stored for this chapter yet.</string>

