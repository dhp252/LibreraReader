    <string name="canvas_t32_card_label">Reading you · chapter finished</string>
    <string name="canvas_t32_card_line">%1$s · %2$d min of reading</string>
    <string name="canvas_t32_card_line_spots">%1$s · %2$d min of reading · spots to review: %3$d</string>
    <string name="canvas_t32_card_open">See how you read it</string>
    <string name="canvas_t32_card_later">Not now</string>

    <!-- the numbers -->
    <string name="canvas_t32_min">%1$d min</string>
    <string name="canvas_t32_under_min">&lt; 1 min</string>
    <string name="canvas_t32_time">reading time, pages on screen</string>
    <string name="canvas_t32_help">times help was offered · taken: %1$d</string>
    <string name="canvas_t32_spots">spots to review</string>

