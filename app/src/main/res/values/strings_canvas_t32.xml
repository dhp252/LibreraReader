    <string name="canvas_t32_attention">Attention, section by section</string>
    <string name="canvas_t32_source_times">PAGE TIMES</string>
    <string name="canvas_t32_steady">Steady</string>
    <string name="canvas_t32_skimmed">Skimmed</string>
    <string name="canvas_t32_struggled">Struggled</string>
